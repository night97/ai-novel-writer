# Anthropic API 配置（必填）
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 最大输出token
MAX_TOKENS=4096

# 可选：OpenAI API
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库
DATABASE_URL=sqlite:///./novel_writer.db

# RAG 配置
# 使用本地 sentence-transformers 做embedding，不需要额外API
RAG_ENABLED=true
